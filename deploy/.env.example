# 复制为 deploy/.env 后填写（勿提交）
# cp deploy/.env.example deploy/.env
# 服务器：welcome(80) / web(1836) / recommend(1837) / cards(1838) / console(1453) 独立镜像与进程；下列 QQ/heartbeat 键留给本机。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=90

WORKER_COUNT=4
RATE_DAILY_LIMIT=100
RATE_MIN_INTERVAL_SEC=0

# QQ 反向 WS（本机 NapCat；服务器不部署 bot）
WS_HOST=0.0.0.0
WS_PORT=8082
WS_ACCESS_TOKEN=

# 网页门卫：公网 TCP 1836；容器内必须 0.0.0.0
# 云安全组放行 TCP 1836
WEB_HOST=0.0.0.0
WEB_PORT=1836

# 模组推荐壳：公网 TCP 1837；容器内 0.0.0.0；安全组放行 TCP 1837
# 问句转义用 DeepSeek（同上 DEEPSEEK_*）；也可单独放在 模组推荐/.env
RECOMMEND_HOST=0.0.0.0
RECOMMEND_PORT=1837
# WORKSHOP_DB=/data/workshop_details_ge300.sqlite
# WORKSHOP_BRIEF_DB=/data/vic3_mods_all.sqlite
# RECOMMEND_LOG_DIR=/app/模组推荐/logs

# 模组卡片壳：公网 TCP 1838；容器内 0.0.0.0；安全组放行 TCP 1838
CARDS_HOST=0.0.0.0
CARDS_PORT=1838
# WORKSHOP_DB=/data/workshop_details_all.sqlite
# WORKSHOP_BRIEF_DB=/data/vic3_mods_all.sqlite
# 1837/1838 共用上述 details（含 title_en/title_zh/author）

SHORT_MEMORY_ENABLED=1
# SHORT_MEMORY_API_KEY=   # 不填则与 DEEPSEEK_API_KEY 同钥（视管线实现）
# 网页整段对话记忆：SHORT_MEMORY_WEB_MAX_TURNS=30 SHORT_MEMORY_INJECT_MAX_CHARS=3500

TOPIC_GATE_ENABLED=1
# TOPIC_GATE_API_KEY=     # 不填则与 SHORT_MEMORY / DEEPSEEK 同钥
# TOPIC_GATE_TIMEOUT_SEC=20

# 运维控制台：只读问答日志；公网 TCP 1453（不对欢迎页展示）；安全组放行
CONSOLE_PORT=1453
CONSOLE_PASSWORD=QWER10uiop
# CONSOLE_LOG_LIMIT=200
# CONSOLE_SESSION_SECRET=
# REQLOG_DIR=/app/核心模块/patchouli/logs
# RECOMMEND_LOG_DIR=/app/模组推荐/logs

# 欢迎页：公网 TCP 80
# WELCOME 无业务 env；compose 服务 welcome

# 以下仅本机 QQ/NapCat 运维用（服务器 compose 不含）
HEARTBEAT_TARGET_QQ=2121396719
HEARTBEAT_ONEBOT_HTTP=http://127.0.0.1:6700
# HEARTBEAT_ONEBOT_PORT=6700

# 官方 QQ 机器人（开放平台；独立服务 qqbot=:3817）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_SANDBOX=1
QQBOT_HEALTH_PORT=3817
# QQBOT_TRUSTED_OPENIDS=openid1,openid2
# QQBOT_MAX_CONTENT_CHARS=1800
