# 复制为 deploy/.env 后填写（勿提交）
# cp deploy/.env.example deploy/.env
# 服务器：welcome(80) / web(1836) / recommend(1837) / cards(1838) / console(1453) / interwar(1910)
# Interwar 官网：公网 TCP 1910（安全组放行 TCP 1910）
# HOI4 国策总览+出图：公网 TCP 1939（安全组放行 TCP 1939）
# INTERWAR_HOST=0.0.0.0
# INTERWAR_PORT=1910
# INTERWAR_DERIVED=/data/1910

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=90

# 网页问答：公网 TCP 1836；容器内必须 0.0.0.0；安全组放行 TCP 1836
WEB_HOST=0.0.0.0
WEB_PORT=1836

# 模组推荐：公网 TCP 1837；安全组放行 TCP 1837
RECOMMEND_HOST=0.0.0.0
RECOMMEND_PORT=1837
# WORKSHOP_DB=/data/workshop_details_all.sqlite
# WORKSHOP_BRIEF_DB=/data/vic3_mods_all.sqlite

# 模组卡片：公网 TCP 1838；安全组放行 TCP 1838
CARDS_HOST=0.0.0.0
CARDS_PORT=1838

SHORT_MEMORY_ENABLED=1
# SHORT_MEMORY_WEB_MAX_TURNS=30 SHORT_MEMORY_INJECT_MAX_CHARS=3500

TOPIC_GATE_ENABLED=1

# 运维控制台：只读问答 / 推荐日志；公网 TCP 1453（不对欢迎页展示）
CONSOLE_PORT=1453
CONSOLE_PASSWORD=QWER10uiop
# CONSOLE_LOG_LIMIT=200
# CONSOLE_SESSION_SECRET=
# REQLOG_DIR=/app/log/1836
# RECOMMEND_LOG_DIR=/app/log/1837
