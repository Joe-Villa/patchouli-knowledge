# HOI4 问答 web=:1936（独立镜像，与 Vic3 :1836 互不知彼此）
# 构建：docker compose -f deploy/docker-compose.yml build hoi4
# 启动：docker compose -f deploy/docker-compose.yml up -d hoi4
# 语料与 log 通过卷挂载

FROM python:3.12-slim-bookworm

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        ripgrep \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY service/1936/web/requirements.txt /tmp/hoi4-web-requirements.txt
RUN pip install --no-cache-dir \
      -i https://mirrors.cloud.tencent.com/pypi/simple \
      --trusted-host mirrors.cloud.tencent.com \
      -r /tmp/hoi4-web-requirements.txt \
    && rm /tmp/hoi4-web-requirements.txt

COPY service/1936 /app/service/1936
COPY tool /app/tool
COPY common /app/common
COPY ingest/_pathsetup.py /app/ingest/_pathsetup.py
COPY ingest/_lib /app/ingest/_lib
COPY ingest/common_registry /app/ingest/common_registry
COPY deploy/patchouli.1936.request.toml /app/service/1936/patchouli.request.toml
COPY deploy/entrypoint.1936.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && rm -rf /app/service/1936/data/game /app/service/1936/data/mods \
    && mkdir -p \
        /app/service/1936/data/game \
        /app/service/1936/data/mods \
        /app/service/1936/sandbox/sessions \
        /app/log/1936/web

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/service/1936:/app \
    CORE_ROOT=/app/service/1936 \
    PATCHOULI_CONFIG=/app/service/1936/patchouli.request.toml \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=1936

WORKDIR /app/service/1936

EXPOSE 1936

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["web"]
