# 运维控制台：与问答 web 镜像完全分离，仅读共享日志卷
# 构建：docker compose -f deploy/docker-compose.yml build console

FROM python:3.12-slim-bookworm

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy/console-requirements.txt /tmp/console-requirements.txt
RUN pip install --no-cache-dir \
      -i https://mirrors.cloud.tencent.com/pypi/simple \
      --trusted-host mirrors.cloud.tencent.com \
      -r /tmp/console-requirements.txt \
    && rm /tmp/console-requirements.txt

# 只拷控制台包 + 空包标记，不进核心模块 / 门卫 / bot
COPY service/1453/console /app/和QQ的通信管线/console
RUN printf '' > /app/和QQ的通信管线/__init__.py \
    && mkdir -p \
        /app/和QQ的通信管线/logs/framework \
        /app/和QQ的通信管线/runtime \
        /app/和QQ的通信管线/console_data

RUN mkdir -p /app/service/1836/patchouli/logs

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CONSOLE_HOST=0.0.0.0 \
    CONSOLE_PORT=1453 \
    FRAMEWORK_LOG_DIR=/app/和QQ的通信管线/logs/framework \
    PROXY_STORE_PATH=/app/和QQ的通信管线/runtime/proxy_tables.json \
    CONSOLE_DATA_DIR=/app/和QQ的通信管线/console_data \
    REQLOG_DIR=/app/service/1836/patchouli/logs

WORKDIR /app/和QQ的通信管线

EXPOSE 1453

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "console"]
