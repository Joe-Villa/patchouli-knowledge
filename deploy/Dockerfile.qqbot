# Patchouli 官方 QQ 机器人（独立镜像 patchouli-qqbot）
# 构建：docker compose -f deploy/docker-compose.yml build qqbot
# 语料通过卷挂载 data/game 与 data/mods

FROM python:3.12-slim-bookworm

# 云主机构建：Debian / PyPI 走腾讯云镜像，避免官方源超时
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g; s|security.debian.org|mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list; \
    fi; \
    apt-get update \
    &&     apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY archive/和QQ的通信管线/requirements.txt /tmp/pipeline-requirements.txt
RUN pip install --no-cache-dir \
      -i https://mirrors.cloud.tencent.com/pypi/simple \
      --trusted-host mirrors.cloud.tencent.com \
      -r /tmp/pipeline-requirements.txt \
    && rm /tmp/pipeline-requirements.txt

# 代码（语料已被 .dockerignore 排除）
COPY archive/和QQ的通信管线 /app/和QQ的通信管线
COPY service/1836 /app/service/1836
COPY deploy/patchouli.request.toml /app/和QQ的通信管线/patchouli.request.toml
COPY deploy/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && mkdir -p \
        /app/service/1836/data/game \
        /app/service/1836/data/mods \
        /app/service/1836/sandbox/sessions \
        /app/service/1836/patchouli/logs \
        /app/和QQ的通信管线/logs/framework \
        /app/和QQ的通信管线/runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CORE_ROOT=/app/service/1836 \
    PATCHOULI_CONFIG=/app/和QQ的通信管线/patchouli.request.toml \
    FRAMEWORK_LOG_DIR=/app/和QQ的通信管线/logs/framework \
    PROXY_STORE_PATH=/app/和QQ的通信管线/runtime/proxy_tables.json \
    WS_HOST=0.0.0.0 \
    WS_PORT=8082 \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=1836 \
    QQBOT_HEALTH_HOST=0.0.0.0 \
    QQBOT_HEALTH_PORT=3817 \
    QQBOT_SANDBOX=1

WORKDIR /app/和QQ的通信管线

# 控制台用独立镜像 deploy/Dockerfile.console，勿再把 console 塞进本镜像运行时依赖
EXPOSE 3817

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["qqbot"]
