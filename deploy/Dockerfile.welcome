# 欢迎页：静态入口，一服务一端口（主机 :80）
# 构建：docker compose -f deploy/docker-compose.yml build welcome

FROM nginx:1.27-alpine

COPY service/80/welcome/nginx.conf /etc/nginx/conf.d/default.conf
COPY service/80/welcome/index.html /usr/share/nginx/html/index.html
COPY service/80/welcome/assets/ /usr/share/nginx/html/assets/

EXPOSE 80
